# Data & model artifacts (fetched/trained locally, never committed)
# Anchored to repo root -- NOT "data/", which would also match ml/ml/data/,
# the source package.
/data/
ml/artifacts/
*.db
*.db-journal

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
npm-debug.log*

# Env
.env
.env.local

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker
*.pid
